    <TextView android:text="Band 3" />
    <SeekBar android:id="@+id/eq_band2" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:text="Band 4" />
    <SeekBar android:id="@+id/eq_band3" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:text="Band 5" />
